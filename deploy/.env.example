# Copy to deploy/.env and adjust. Every compose command in deploy/ reads it.
BSLLMNER_VIEWER_STORE_DIR=/path/to/stores
BSLLMNER_VIEWER_STORE_FILE=current.duckdb
BSLLMNER_VIEWER_PORT=20081
BSLLMNER_VIEWER_API_WORKERS=2
BSLLMNER_VIEWER_THREADS=8
# true for a deployment that search engines must not index, such as staging.
BSLLMNER_VIEWER_NOINDEX=false
# Limits of each api worker. The values below are the defaults.
#BSLLMNER_VIEWER_MEMORY_LIMIT=4GB
#BSLLMNER_VIEWER_MAX_TEMP_SIZE=20GB
#BSLLMNER_VIEWER_QUERY_TIMEOUT=60
#BSLLMNER_VIEWER_MAX_QUERIES=8
#BSLLMNER_VIEWER_MAX_EXPORTS=2
#BSLLMNER_VIEWER_QUEUE_TIMEOUT=10
# The temporary directory is the volume that compose mounts at /var/tmp/bsllmner-viewer.
# Outside compose, set BSLLMNER_VIEWER_TEMP_DIRECTORY (default: a directory in the system temporary directory).
