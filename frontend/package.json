{
  "name": "bsllmner-viewer-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "gen:api-types": "openapi-typescript ../backend/openapi.json -o app/lib/api/openapi-types.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/public-sans": "^5.2.5",
    "@react-router/node": "^7.18.2",
    "@tanstack/react-query": "^5.90.2",
    "isbot": "^5",
    "openapi-fetch": "^0.14.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@fast-check/vitest": "^0.2.1",
    "@playwright/test": "^1.50.0",
    "@react-router/dev": "^7.18.2",
    "@stylistic/eslint-plugin": "^4.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fast-check": "^4.7.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
