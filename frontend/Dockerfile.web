# Production image: the built single-page application served by nginx, which also proxies /api to the api container.
# The build context is the root of the repository, because the image also serves a file that it makes from docs/.
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
# The commit that the footer shows. After the copy, so that a new value rebuilds only the build step.
ARG BSLLMNER_VIEWER_COMMIT=
RUN npm run build && node nginx/csp-hashes.mjs build/client/index.html /app/csp-hashes.conf
# /llms-full.txt: the rules of the api and the data model in one file. Only these two documents are copied, so a change
# of another document does not rebuild the image. The links to other documents name the commit.
COPY docs/api.md docs/data-model.md /docs/
RUN node scripts/llms-full.ts /docs build/client/llms-full.txt

FROM nginx:1.29-alpine
# The image's entrypoint writes the nameservers into NGINX_LOCAL_RESOLVERS and fills the template with the filtered variables.
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 \
    NGINX_ENVSUBST_FILTER="^(BSLLMNER_VIEWER_|NGINX_LOCAL_RESOLVERS$)" \
    BSLLMNER_VIEWER_NOINDEX=false
COPY --from=build /app/build/client /usr/share/nginx/html
COPY --from=build /app/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/nginx/proxy.inc /app/csp-hashes.conf /etc/nginx/
COPY --from=build /app/nginx/robots.txt /app/nginx/robots.noindex.txt /usr/share/nginx/robots/
EXPOSE 80
