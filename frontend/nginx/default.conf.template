include /etc/nginx/csp-hashes.conf;
# The nginx image replaces ${BSLLMNER_VIEWER_*} and ${NGINX_LOCAL_RESOLVERS} when the container starts.

map "${BSLLMNER_VIEWER_NOINDEX}" $robots_file {
    true    /robots.noindex.txt;
    default /robots.txt;
}

# An export is data for programs, so no deployment lets search engines index it.
map "${BSLLMNER_VIEWER_NOINDEX}:$uri" $x_robots_tag {
    ~^true:              noindex;
    ~^[^:]*:/api/export/ noindex;
    default              "";
}

# The Swagger UI and ReDoc pages of the api load their scripts, styles, and fonts from the CDNs that FastAPI uses by default.
map $uri $csp {
    ~^/api(/redoc)?$ "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' https://cdn.jsdelivr.net https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://fastapi.tiangolo.com https://cdn.redoc.ly; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'";
    ~^/api/     "default-src 'none'; frame-ancestors 'none'";
    default     "default-src 'self'; script-src 'self' $csp_script_hashes; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'";
}

# Every add_header is set at the server level, because a location with its own add_header drops the inherited ones.
# A 404 under /assets/ gets no-cache.
map "$status:$uri" $cache_control_v {
    ~^(200|206|304):/assets/ "public, max-age=31536000, immutable";
    ~^[0-9]+:/api            "";
    default                  no-cache;
}

# The api sets these headers for its own responses. nginx sets them for the errors that it returns.
# An export holds a slot of the api for minutes, so a client with too many exports waits longer before it tries again.
map "$status:$uri" $retry_after {
    ~^429:/api/export/ 10;
    ~^429:             1;
    default            "";
}

map $uri $too_many_detail {
    ~^/api/export/ "This client has too many exports in progress.";
    default        "This client has too many requests in progress.";
}

# The request ID of the gateway is used when it is safe to put in a JSON body. Otherwise nginx makes its own.
map $http_x_request_id $problem_request_id {
    "~^[A-Za-z0-9._-]{1,128}$" $http_x_request_id;
    default                  $request_id;
}

map $status $nginx_request_id {
    413     $problem_request_id;
    429     $problem_request_id;
    default "";
}

# The api allows every origin. nginx does the same for the errors that it returns.
map $status $cors_origin {
    413     "*";
    429     "*";
    default "";
}

map $status $cors_expose {
    413     "Retry-After, X-Request-ID";
    429     "Retry-After, X-Request-ID";
    default "";
}

map $http_x_forwarded_proto $hsts {
    https   "max-age=31536000";
    default "";
}

# The path in the body of a 413 response is limited to characters that need no JSON escaping.
map $uri $problem_instance {
    ~^(/[A-Za-z0-9_.~/-]*)$ $1;
    default                 /api;
}

limit_conn_zone $binary_remote_addr zone=per_client:10m;
limit_conn_zone $binary_remote_addr zone=per_client_export:10m;

map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# The combined format, followed by the seconds of the request, the seconds of the api, and the request ID of the
# response. The warnings and errors in the log of the api name the same request ID.
log_format timed '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent '
                 '"$http_referer" "$http_user_agent" '
                 'request_time=$request_time upstream_time=$upstream_response_time request_id=$sent_http_x_request_id';

server {
    listen 80;
    server_name _;
    server_tokens off;

    access_log /var/log/nginx/access.log timed;

    root /usr/share/nginx/html;
    index index.html;

    # The api container gets a new address when it restarts, so its name is looked up again after 10 seconds.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $api_upstream http://api:8000;

    gzip on;
    # Level 6 makes the scripts of the first page about 15% smaller than the default level 1, and uses little more CPU.
    gzip_comp_level 6;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/markdown text/tab-separated-values application/javascript application/json application/x-ndjson image/svg+xml;

    add_header Cache-Control $cache_control_v always;
    add_header Content-Security-Policy $csp always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Robots-Tag $x_robots_tag always;
    add_header Strict-Transport-Security $hsts always;
    add_header Retry-After $retry_after always;
    add_header X-Request-ID $nginx_request_id always;
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Expose-Headers $cors_expose always;

    # The gateway and the container networks use private addresses. For a peer in these ranges, the X-Real-IP header
    # of the request is the address of the client. For a peer outside these ranges, the address of the peer is the
    # address of the client.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from ::1;
    set_real_ip_from fc00::/7;
    real_ip_header X-Real-IP;

    # A body that the api accepts is far smaller than this limit.
    client_max_body_size 64k;

    location ~ ^/api(/|$) {
        limit_conn per_client 100;
        limit_conn_status 429;
        error_page 413 @payload_too_large;
        error_page 429 @too_many_requests;
        proxy_pass $api_upstream;
        include /etc/nginx/proxy.inc;

        # An export keeps a slot of the api until the client has read all of it. A location that sets limit_conn does
        # not inherit the limit of the location around it, and proxy_pass is never inherited.
        location ~ ^/api/export/ {
            limit_conn per_client 100;
            limit_conn per_client_export 2;
            proxy_pass $api_upstream;
        }
    }

    # Clients look for the OpenAPI document at the default path of FastAPI. The relative Location keeps the scheme and
    # the host of the reverse proxy in front of the web container.
    location = /openapi.json {
        absolute_redirect off;
        return 301 /api/openapi.json;
    }

    location @payload_too_large {
        default_type application/problem+json;
        return 413 '{"type":"about:blank","title":"Content Too Large","status":413,"detail":"The request body is larger than 64 KiB.","instance":"$problem_instance","timestamp":"$time_iso8601","requestId":"$problem_request_id"}';
    }

    location @too_many_requests {
        default_type application/problem+json;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"$too_many_detail","instance":"$problem_instance","timestamp":"$time_iso8601","requestId":"$problem_request_id"}';
    }

    location = /robots.txt {
        root /usr/share/nginx/robots;
        try_files $robots_file =404;
    }

    location ~ ^/llms(-full)?\.txt$ {
        types { }
        default_type text/markdown;
        charset utf-8;
        charset_types text/markdown;
    }

    location /assets/ {
        try_files $uri =404;
    }

    # The routes of the single-page application. A path that is neither a file nor a route is a 404.
    location ~ ^/(entries(/[^/]+)?/?)?$ {
        try_files /index.html =404;
    }

    location / {
        try_files $uri =404;
        error_page 404 /index.html;
    }
}
