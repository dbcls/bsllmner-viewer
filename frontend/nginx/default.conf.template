# The nginx image replaces ${BSLLMNER_VIEWER_*} and ${NGINX_LOCAL_RESOLVERS} when the container starts.

map "${BSLLMNER_VIEWER_NOINDEX}" $robots_file {
    true    /robots.noindex.txt;
    default /robots.txt;
}

map "${BSLLMNER_VIEWER_NOINDEX}" $x_robots_tag {
    true    noindex;
    default "";
}

# One add_header set at the server level, because a location with its own add_header drops the inherited ones.
map $uri $cache_control {
    ~^/assets/ "public, max-age=31536000, immutable";
    ~^/api     "";
    default    no-cache;
}

map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # The api container gets a new address when it restarts, so its name is looked up again after 10 seconds.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $api_upstream http://api:8000;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/markdown text/tab-separated-values application/javascript application/json application/x-ndjson image/svg+xml;

    add_header Cache-Control $cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Robots-Tag $x_robots_tag always;

    location = /api {
        proxy_pass $api_upstream;
        include /etc/nginx/proxy.inc;
    }

    location /api/ {
        proxy_pass $api_upstream;
        include /etc/nginx/proxy.inc;
    }

    location = /robots.txt {
        root /usr/share/nginx/robots;
        try_files $robots_file =404;
    }

    location = /llms.txt {
        types { }
        default_type "text/markdown; charset=utf-8";
    }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
