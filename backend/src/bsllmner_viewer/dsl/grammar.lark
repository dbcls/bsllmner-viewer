// Condition DSL grammar (Lark LALR(1)). The grammar is the Lucene subset used by
// the DDBJ Search API `/db-portal/*` endpoints; a condition string parses to an
// AST of the same shape in both. A wildcard value is accepted by the grammar
// and rejected by validation, so error positions stay comparable.

start: or_expr

or_expr: and_expr (OR and_expr)*
and_expr: not_expr (AND not_expr)*
not_expr: NOT atom   -> not_op
        | atom       -> atom_passthrough
?atom: field_clause
     | free_text_atom
     | "(" or_expr ")"
// A field name and a free-text word are both WORD tokens. The parser reads
// one token ahead: a WORD followed by ``:`` is a field name.
field_clause: WORD ":" value
// Space-separated bare words (e.g. ``cancer tumor``) become one free-text
// value. The compiler requires every word of the value to match.
free_text_atom: PHRASE -> ft_phrase
              | WORD+  -> ft_word

value: PHRASE    -> v_phrase
     | RANGE     -> v_range
     | WILDCARD  -> v_wildcard
     | DATE      -> v_date
     | WORD      -> v_word

// AND / OR / NOT must outrank WORD so a bare ``NOT`` is recognised as the
// operator instead of being absorbed into ``free_text_atom: WORD``. An operator
// must not be followed by a WORD character, so ``NOTCH1`` and ``ORGANOID`` are
// words while ``NOT(a)``, ``a OR "x"``, and ``NOT'x'`` read the operator.
AND.10: /AND(?![^\s:()\[\]"'{}^~*?\/])/
OR.10: /OR(?![^\s:()\[\]"'{}^~*?\/])/
NOT.10: /NOT(?![^\s:()\[\]"'{}^~*?\/])/

// A single-quoted phrase closes at a `'` that a space, `)`, or the end follows. A
// `'` inside the phrase that another character follows is part of the phrase,
// as in 'Alzheimer's disease'.
PHRASE.5: /"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.|'(?=[^\s)]))*'(?![^\s)])/
RANGE.5: /\[[^\s\]]+\s+TO\s+[^\s\]]+\]/
DATE.4: /\d{4}-\d{2}-\d{2}/
// WILDCARD is a narrower character class than WORD. A WILDCARD token has one
// wildcard marker (`*` or `?`), with ASCII letters, digits, `_`, `-`, and `.`
// before and after it. A wildcard value parses, so that validation rejects it
// with the position of its clause. A wildcard marker in a bare word is a
// syntax error.
WILDCARD.3: /[A-Za-z0-9_\-.]*[*?][A-Za-z0-9_\-.]*/
// A WORD does not start where a single-quoted phrase starts, so a closed '...'
// after a word is a syntax error, as a phrase next to a word is. A `'` that no
// closing `'` follows starts a word, as in `'s`.
WORD.1: /(?!'(?:[^'\\]|\\.|'(?=[^\s)]))*'(?![^\s)]))[^\s:()\[\]"{}^~*?\/]+/

%ignore /\s+/
